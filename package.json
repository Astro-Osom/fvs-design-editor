{
  "name": "fvs-design-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, local-first design editor for photo editing and YouTube thumbnails.",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm build:desktop && playwright test",
    "build:desktop": "vite build && node scripts/build-electron.mjs",
    "desktop": "install-electron && pnpm build:desktop && electron .",
    "fonts:catalogue": "node scripts/update-google-fonts-catalogue.mjs"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "fabric": "7.4.0",
    "fflate": "0.8.3",
    "lucide-react": "1.77.0",
    "motion": "14.14.0",
    "onnxruntime-web": "1.31.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@fontsource/lobster": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.4.1",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.2.8",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
